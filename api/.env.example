# Template for a production deployment. `make setup` writes a development
# api/.env for you — this file documents what each setting does.
#
# Never commit a filled-in copy. Generate keys with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

DLT_ENV=production
DLT_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# sslmode is required in production; verify-full also checks the hostname.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dlt?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca.pem

# --- Cryptography -----------------------------------------------------------
# Key-encryption key. Wraps every account's data key.
# LOSING THIS MAKES EVERY ENCRYPTED COLUMN PERMANENTLY UNREADABLE.
# To rotate: add DLT_KEK_V2, set ACTIVE_VERSION=2, run `flask rewrap-keys`,
# then remove V1 once it reports zero remaining.
DLT_KEK_V1=
DLT_KEK_ACTIVE_VERSION=1

# Keyed HMAC for the email lookup index. Cannot be rotated without
# re-deriving every index.
DLT_BLIND_INDEX_KEY=

# HMAC key for scan, session and relay tokens. Rotating it invalidates every
# printed tag.
DLT_TOKEN_PEPPER=

# --- Web --------------------------------------------------------------------
DLT_FRONTEND_ORIGIN=https://tags.example.com
DLT_PUBLIC_BASE_URL=https://tags.example.com
DLT_COOKIE_SECURE=true
# DLT_COOKIE_DOMAIN=

# Number of proxies you actually run. 0 ignores X-Forwarded-For entirely,
# which is correct for a directly exposed app and wrong behind a load
# balancer. Setting it too high lets clients spoof their own address.
DLT_TRUSTED_PROXY_HOPS=1

# --- Sessions and passwords -------------------------------------------------
DLT_SESSION_IDLE_MINUTES=60
DLT_SESSION_ABSOLUTE_HOURS=336
DLT_MAX_SESSIONS_PER_USER=10
DLT_PASSWORD_MIN_LENGTH=12
DLT_LOGIN_MAX_ATTEMPTS=8
DLT_LOGIN_LOCKOUT_MINUTES=15
# Argon2id cost. Raise these to match your hardware; existing hashes are
# upgraded transparently at each user's next sign-in.
DLT_ARGON2_TIME_COST=3
DLT_ARGON2_MEMORY_COST=65536
DLT_ARGON2_PARALLELISM=2

# --- Rate limiting ----------------------------------------------------------
# The in-memory default is per-worker: four workers means four times your
# configured limit. Use Redis for anything multi-process.
DLT_RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Mail -------------------------------------------------------------------
# For Gmail with an app password (requires 2-Step Verification on the account):
#   DLT_SMTP_HOST=smtp.gmail.com
#   DLT_SMTP_PORT=587
#   DLT_SMTP_USERNAME  and  DLT_MAIL_FROM   your full Gmail address; they must
#                                           match, because Gmail rewrites a
#                                           From header it did not authenticate
#   DLT_SMTP_PASSWORD  the 16-character app password, spaces removed
# Consumer Gmail accounts are capped near 500 recipients a day — fine for a
# self-hosted instance, not for a managed one.
DLT_MAIL_PROVIDER=smtp
DLT_MAIL_FROM=no-reply@example.com
DLT_SMTP_HOST=
DLT_SMTP_PORT=587
DLT_SMTP_USERNAME=
DLT_SMTP_PASSWORD=
DLT_SMTP_STARTTLS=true

# --- Geolocation ------------------------------------------------------------
# null never resolves anything. header reads city headers your CDN already
# computed — only safe if your edge strips them from client requests.
DLT_GEO_PROVIDER=null
# DLT_GEO_CITY_HEADER=CF-IPCity
# DLT_GEO_REGION_HEADER=CF-Region
# DLT_GEO_COUNTRY_HEADER=CF-IPCountry

# --- Retention --------------------------------------------------------------
# Enforced by `flask purge` — schedule it.
DLT_SCAN_RETENTION_DAYS=90
DLT_RELAY_RETENTION_DAYS=30
DLT_AUDIT_RETENTION_DAYS=365
DLT_SCAN_DEDUP_MINUTES=10
DLT_SCAN_NOTIFY_COOLDOWN_MINUTES=30
# Minimum gap between "the owner replied" emails to a finder, per conversation.
DLT_RELAY_NOTIFY_COOLDOWN_MINUTES=10
